# Supabase — projeto EXCLUSIVO do PITCHAT (não reutilizar o do PitBrain).
# Padrão novo de API keys do Supabase (sb_publishable_/sb_secret_), não os
# nomes legados anon/service_role — ver docs/PITCHAT_ARCHITECTURE.md §2.
NEXT_PUBLIC_SUPABASE_URL=https://your-pitchat-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Mesma URL do campo acima, em variável sem NEXT_PUBLIC_ — usada só em código
# server-side (lib/supabase/admin.ts, server.ts, middleware.ts).
SUPABASE_URL=https://your-pitchat-project.supabase.co
# Server-side APENAS. Nunca importar em Client Component nem logar.
SUPABASE_SECRET_KEY=sb_secret_...

# Autenticação NÃO-INTERATIVA do Supabase CLI (scripts/supabase-cli.mjs) — não
# confundir com as keys acima, que são da aplicação. Nunca usadas pelo
# runtime nem pelo browser. Ver supabase/README.md.
# PAT da sua conta Supabase: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Senha do Postgres DESTE projeto (Settings → Database → Reset database password)
SUPABASE_DB_PASSWORD=

# Acesso restrito — e-mails autorizados a logar (separados por vírgula).
# Cadastro público está desativado; crie o usuário manualmente no Supabase Auth.
PITCHAT_ALLOWED_EMAILS=

# Upstash QStash — fila de delay/retry (motor de automação). Criar conta em
# https://console.upstash.com/qstash
# QSTASH_URL só é necessária se a conta for de uma região específica (ex:
# EU) — o SDK @upstash/qstash lê essa env sozinho (Client/Receiver não
# precisam de nenhum código extra pra isso). Sem ela, usa o endpoint global
# padrão (https://qstash.upstash.io).
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Meta / Instagram — ainda não existe (ver docs/PITCHAT_META_INTEGRATION.md §12
# para o checklist exato de criação do App).
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v26.0
# Chave simétrica pra criptografar o access_token do Instagram em repouso
# (social_accounts.access_token_encrypted). Gerar com: openssl rand -base64 32
META_TOKEN_ENCRYPTION_KEY=

# URL pública onde o PITCHAT roda — o QStash precisa disso pra chamar de
# volta os callbacks de delay/webhook. Não funciona com localhost; em dev,
# use um túnel (ngrok, Cloudflare Tunnel) ou o domínio real da Vercel.
PITCHAT_APP_URL=
